{
  "name": "EVENT 03 — Seating Plan + Doorprize Draw Otomatis",
  "nodes": [
    {
      "parameters": {
        "path": "ev-checkin",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Guest Check-In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "ev-checkin"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nconst name = String(b.name || '').toLowerCase().trim();\nconst rows = $('Read List Guest').all().map(r => r.json);\n\nconst found = rows.find(r =>\n  String(r.name || '').toLowerCase().trim() === name);\n\nif (!found) {\n  return [{ json: { ditemukan: false, name: b.name } }];\n}\nreturn [{ json: { ditemukan: true, ...found } }];\n"
      },
      "id": "n2",
      "name": "Check Registered Guests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Cocokkan name tamu dengan list RSVP."
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "RSVP",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n3",
      "name": "Read List Guest",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{ $json.ditemukan ? 1 : 0 }}",
              "rightValue": "1",
              "operator": {
                "type": "number",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Registered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "Welcome, {{$json.name}}! 🎊\\n\\nCheck-in successful.\\nTable : {{$json.meja || 'to be announced'}}\\nNomor doorprize: {{$json.nomor_doorprize || '-'}}\\n\\nEnjoy the event 💛"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Welcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "GUEST NOT REGISTERED ⚠️\\n======================\\nNama : {{$json.name}}\\n\\nNeeds a manual check at the registration desk."
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Notify Committee (Unregistered Guest)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        420
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Kehadiran",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n7",
      "name": "Log Attendance",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 21 * * *"
            }
          ]
        }
      },
      "id": "n8",
      "name": "Draw Doorprize When Event Ends",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        620
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Kehadiran",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n9",
      "name": "Read Attendees",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        420,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst pool = rows.filter(r => r.name);\nif (pool.length < 3) return [{ json: { skip: true } }];\n\nconst pemenang = [];\nconst salinan = [...pool];\nfor (let i = 0; i < 3 && salinan.length > 0; i++) {\n  const idx = Math.floor(Math.random() * salinan.length);\n  pemenang.push(salinan.splice(idx, 1)[0]);\n}\n\nlet out = 'PEMENANG DOORPRIZE 🎁\\n===================\\n\\n';\npemenang.forEach((p, i) => {\n  out += (i + 1) + '. ' + p.name + ' — ' + (p.meja || 'meja -') + '\\n';\n});\nreturn [{ json: { skip: false, result: out } }];\n"
      },
      "id": "n10",
      "name": "Draw 3 Winners",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        620
      ],
      "notes": "Undi 3 pemenang acak from that hadir."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{ $('Draw 3 Winners').first().json.result }}"
            }
          ]
        },
        "options": {}
      },
      "id": "n11",
      "name": "Announce Winners",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        620
      ]
    }
  ],
