{
  "name": "EVENT 01 — RSVP + Reminder Undangan (Wedding/Event)",
  "nodes": [
    {
      "parameters": {
        "path": "ev-rsvp",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "RSVP Incoming",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "ev-rsvp"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  name: b.name || 'Guest',\n  WhatsApp: String(b.WhatsApp || b.phone || '').replace(/[^0-9]/g, ''),\n  event: b.nama_event || 'Event',\n  date: b.date || '-',\n  hour: b.hour || '-',\n  location: b.location || '-',\n  amount: Number(b.jumlah_orang || 1),\n  confirm: (b.hadir || 'yes').toLowerCase() === 'yes' ? 'attending' : 'not attending',\n  time: new Date().toLocaleString('en-US')\n}}];\n"
      },
      "id": "n2",
      "name": "Normalize Guest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Samakan format RSVP."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "RSVP",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n3",
      "name": "Log RSVP",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{ $json.confirm }}",
              "rightValue": "hadir",
              "operator": {
                "type": "string",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Attending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "Thank you for confirming, {{$json.name}} 🙏\\n\\nWe look forward to seeing you at:\\n{{$json.event}}\\n📅 {{$json.date}} · {{$json.hour}}\\n📍 {{$json.location}}\\n\\nJumlah: {{$json.amount}} orang"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Thank You (Attending)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "Thank you for letting us know, {{$json.name}}.\\n\\nWe respect your decision. Your good wishes mean a lot to us.\\n\\nSee you at another occasion 💛"
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Confirm Not Attending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "NEW RSVP\\n========\\nNama    : {{$('Normalize Guest').first().json.name}}\\nEvent   : {{$('Normalize Guest').first().json.event}}\\nStatus  : {{$('Normalize Guest').first().json.confirm}}\\nGuests : {{$('Normalize Guest').first().json.amount}} people\\n\\nTotal guests logged to Sheets."
            }
          ]
        },
        "options": {}
      },
      "id": "n7",
      "name": "Notify Event Organizer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "RSVP Incoming": {
      "main": [
        [
          {
            "node": "Normalize Guest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Guest": {
      "main": [
        [
          {
            "node": "Log RSVP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log RSVP": {
      "main": [
        [
          {
            "node": "Attending?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attending?": {
      "main": [
        [
          {
            "node": "Thank You (Attending)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Confirm Not Attending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Thank You (Attending)": {
      "main": [
        [
          {
            "node": "Notify Event Organizer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm Not Attending": {
      "main": [
        [
          {
            "node": "Notify Event Organizer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}