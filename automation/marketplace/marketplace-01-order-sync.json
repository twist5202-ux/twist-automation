{
  "name": "MARKETPLACE 01 — Multi-Platform Order Sync (Shopee/Tokopedia/TikTok)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -300,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://developer.shopeemobile.com/api/v2/order/get_order_list?order_status=READY_TO_SHIP&time_range_field=create_time&time_from=REPLACE_TIMESTAMP_FROM&time_to=REPLACE_TIMESTAMP_TO&page_size=50",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_SIGN_SHOPEE"
            }
          ]
        }
      },
      "id": "n2",
      "name": "Fetch Shopee Orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -60,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://fs.tokopedia.net/v2/order/list?from_date=REPLACE_FROM_DATE&to_date=REPLACE_TO_DATE&shop_id=REPLACE_SHOP_ID&fs_id=REPLACE_FS_ID",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_TOKEN_TOKOPEDIA"
            }
          ]
        }
      },
      "id": "n3",
      "name": "Fetch Tokopedia Orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -60,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst shopee = $('Fetch Shopee Orders').first().json.response?.order_list || [];\nconst tokped = $('Fetch Tokopedia Orders').first().json.data || [];\n\nconst out = [];\nfor (const o of shopee) {\n  out.push({ json: {\n    sumber: 'Shopee',\n    order_id: o.order_sn,\n    buyer: o.buyer_user_name,\n    total: o.total_amount,\n    status: o.order_status,\n    courier: o.shipping_carrier,\n    tracking number: o.package_number || '-'\n  }});\n}\nfor (const o of tokped) {\n  out.push({ json: {\n    sumber: 'Tokopedia',\n    order_id: o.invoice_ref_num,\n    buyer: o.buyer_full_name,\n    total: o.total_price,\n    status: o.order_status,\n    courier: o.shipping_agency || '-',\n    tracking number: o.shipping_receipt || '-'\n  }});\n}\nreturn out;\n"
      },
      "id": "n4",
      "name": "Merge & Normalize Orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "notes": "Samakan format order from berbagai platform."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Order",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n5",
      "name": "Log to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst all = $input.all().map(r => r.json);\nconst shopee = all.filter(o => o.source === 'Shopee').length;\nconst tokped = all.filter(o => o.source === 'Tokopedia').length;\nconst revenue = all.reduce((s, o) => s + (Number(o.total) || 0), 0);\n\nlet out = 'NEW ORDERS\\n==========\\n\\n';\nout += 'Shopee    : ' + shopee + ' orders\\n';\nout += 'Tokopedia : ' + tokped + ' orders\\n';\nout += 'Total     : ' + all.length + ' orders\\n';\nout += 'Revenue   : Rp ' + revenue.toLocaleString('en-US') + '\\n\\n';\nout += 'All logged to Sheets.';\nreturn [{ json: { report: out } }];\n"
      },
      "id": "n6",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "notes": ""
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.report}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n7",
      "name": "Notify Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Check Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Shopee Orders",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Tokopedia Orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Shopee Orders": {
      "main": [
        [
          {
            "node": "Merge & Normalize Orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Tokopedia Orders": {
      "main": [
        [
          {
            "node": "Merge & Normalize Orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge & Normalize Orders": {
      "main": [
        [
          {
            "node": "Log to Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Sheets": {
      "main": [
        [
          {
            "node": "Build Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Summary": {
      "main": [
        [
          {
            "node": "Notify Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}