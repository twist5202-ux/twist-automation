{
  "name": "MARKETPLACE 02 — Stock Multi-Platform Sync (Out → Alert)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Stok",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Local Stock",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nreturn rows.filter(r => Number(r.stock) <= Number(r.min_stock || 5))\n  .map(r => {\n    const stock = Number(r.stock);\n    const min = Number(r.min_stock || 5);\n    let level = 'YELLOW';\n    if (stock === 0) level = 'RED — OUT OF STOCK';\n    else if (stock <= min / 2) level = 'ORANGE';\n    return { json: {\n      sku: r.sku, product: r.product, stock: stock, min_stock: min, level\n    }};\n  });\n"
      },
      "id": "n3",
      "name": "Check Stock Low",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "notes": "Bandingkan stock aktual vs minimum."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{ $json.stock }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Stock Critical?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "OUT OF STOCK\\n==========\\nSKU    : {{$json.sku}}\\nProduct : {{$json.product}}\\nStock  : {{$json.stock}}\\nMinimum: {{$json.min_stock}}\\n\\nDeactivate the listing or restock immediately."
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Alert Out of Stock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "LOW STOCK\\n===========\\nSKU    : {{$json.sku}}\\nProduct : {{$json.product}}\\nLeft   : {{$json.stock}} (min {{$json.min_stock}})\\n\\nConsider restocking."
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Alert Low Stock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        420
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Stok",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "sku"
          ],
          "schema": []
        },
        "options": {}
      },
      "id": "n7",
      "name": "Update Stock Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Check Every Hour": {
      "main": [
        [
          {
            "node": "Read Local Stock",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Local Stock": {
      "main": [
        [
          {
            "node": "Check Stock Low",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Stock Low": {
      "main": [
        [
          {
            "node": "Stock Critical?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stock Critical?": {
      "main": [
        [
          {
            "node": "Alert Out of Stock",
            "type": "main",
            "index": 0
          },
          {
            "node": "Alert Low Stock",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Out of Stock": {
      "main": [
        [
          {
            "node": "Update Stock Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Low Stock": {
      "main": [
        [
          {
            "node": "Update Stock Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}