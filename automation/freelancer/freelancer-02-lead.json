{
  "name": "FREELANCER 02 — Lead Follow-Up (Prospective Klien Diam → Dikejar)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Morning at 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Lead",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Lead List",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst now = Date.now();\nreturn rows.filter(r => {\n  if (r.status !== 'new') return false;\n  const t = new Date(r.waktu_chat).getTime();\n  return (now - t) / 86400000 >= 3;\n}).map(r => ({ json: r }));\n"
      },
      "id": "n3",
      "name": "Filter Idle > 3 Days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "Halo {{$json.name}} 👋\\n\\nA few days ago you asked about *{{$json.service}}*.\\n\\nStill interested? If you have any concerns (price, timeline, scope), just say so — we can find a way.\\n\\nI am happy to help any time."
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Follow Up Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Lead",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n5",
      "name": "Update Lead Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Check Every Morning at 10:00": {
      "main": [
        [
          {
            "node": "Read Lead List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Lead List": {
      "main": [
        [
          {
            "node": "Filter Idle > 3 Days",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Idle > 3 Days": {
      "main": [
        [
          {
            "node": "Follow Up Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Follow Up Lead": {
      "main": [
        [
          {
            "node": "Update Lead Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}