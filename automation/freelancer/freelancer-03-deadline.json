{
  "name": "FREELANCER 03 — Project Deadline Tracker (Do not Late Delivery)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Morning at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Project",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Active Projects",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst now = new Date();\nreturn rows.filter(r => {\n  if (r.status === 'done') return false;\n  const dl = new Date(r.deadline);\n  const sisa = Math.ceil((dl - now) / 86400000);\n  return sisa <= 2;\n}).map(r => {\n  const sisa = Math.ceil((new Date(r.deadline) - now) / 86400000);\n  return { json: { ...r, sisa_hari: sisa } };\n});\n"
      },
      "id": "n3",
      "name": "Filter Near Deadline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "⏰ DEADLINE APPROACHING\\n\\nProject  : {{$json.nama_project}}\\nClient   : {{$json.klien}}\\nDeadline : {{$json.deadline}}\\nDays left: {{$json.sisa_hari}} days\\nProgress : {{$json.progress}}\\n\\nDo not miss the delivery!"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Alert Deadline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Check Every Morning at 08:00": {
      "main": [
        [
          {
            "node": "Read Active Projects",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Active Projects": {
      "main": [
        [
          {
            "node": "Filter Near Deadline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Near Deadline": {
      "main": [
        [
          {
            "node": "Alert Deadline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}