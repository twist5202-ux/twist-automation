{
  "name": "FREELANCER 01 — Invoice Reminder (Klien Late Bayar)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Morning at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Invoice",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Unpaid Invoices",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst now = new Date();\nconst overdue = rows.filter(r => {\n  if (r.status === 'paid') return false;\n  const date = new Date(r.jatuh_tempo);\n  return date <= now;\n});\nreturn overdue.map(r => {\n  const daysLate = Math.floor((now - new Date(r.jatuh_tempo)) / 86400000);\n  return { json: { ...r, hari_telat: daysLate } };\n});\n"
      },
      "id": "n3",
      "name": "Filter Due Date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "Halo {{$json.client_name}} 👋\\n\\nA reminder about invoice *{{$json.no_invoice}}*:\\n\\nProject  : {{$json.project}}\\nAmount   : Rp {{$json.value}}\\nDue date   : {{$json.jatuh_tempo}}\\nOverdue  : {{$json.hari_telat}} days\\n\\nPlease process it as soon as possible. If you have already transferred, send the proof. Thank you 🙏"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Remind Client",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Log",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n5",
      "name": "Log Reminder Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Check Every Morning at 09:00": {
      "main": [
        [
          {
            "node": "Read Unpaid Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Unpaid Invoices": {
      "main": [
        [
          {
            "node": "Filter Due Date",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Due Date": {
      "main": [
        [
          {
            "node": "Remind Client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Remind Client": {
      "main": [
        [
          {
            "node": "Log Reminder Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}