{
  "name": "EDUCATION 02 — Reminder Kelas + Tagihan Siswa",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Morning at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Jadwal",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Class Schedule",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst dayName = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][new Date().getDay()];\nreturn rows.filter(r => (r.day || '') === dayName)\n  .map(r => ({ json: { ...r, day: dayName } }));\n"
      },
      "id": "n3",
      "name": "Filter Today's Classes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "notes": "Fetch kelas that jadwalnya today."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "CLASS REMINDER TODAY 📚\\n==========================\\nClass   : {{$json.nama_kelas}}\\nTime    : {{$json.hour}}\\nTeacher : {{$json.pengajar}}\\nVenue   : {{$json.tempat}}\\n\\nDo not forget to bring your books and stationery."
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Class Reminder to Student",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Tagihan",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n5",
      "name": "Read Bills",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst now = new Date();\nreturn rows.filter(r => {\n  if (r.status === 'paid') return false;\n  const date = new Date(r.jatuh_tempo);\n  const sisa = Math.ceil((date - now) / 86400000);\n  return sisa <= 3;\n}).map(r => {\n  const sisa = Math.ceil((new Date(r.jatuh_tempo) - now) / 86400000);\n  return { json: { ...r, sisa_hari: sisa } };\n});\n"
      },
      "id": "n6",
      "name": "Filter Due Bills",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        500
      ],
      "notes": "Tagihan that due date <= 3 hari."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "PAYMENT REMINDER\\n===================\\nStudent    : {{$json.nama_siswa}}\\nMonth      : {{$json.month}}\\nAmount     : Rp {{$json.amount}}\\nDue date   : {{$json.jatuh_tempo}}\\nDays left  : {{$json.sisa_hari}} days\\n\\nPlease process it as soon as possible. If you have already paid, send the transfer receipt. Thank you 🙏"
            }
          ]
        },
        "options": {}
      },
      "id": "n7",
      "name": "Bill Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        500
      ]
    }
  ],
  "connections": {
    "Check Every Morning at 07:00": {
      "main": [
        [
          {
            "node": "Read Class Schedule",
            "type": "main",
            "index": 0
          },
          {
            "node": "Read Bills",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Class Schedule": {
      "main": [
        [
          {
            "node": "Filter Today's Classes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Today's Classes": {
      "main": [
        [
          {
            "node": "Class Reminder to Student",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Bills": {
      "main": [
        [
          {
            "node": "Filter Due Bills",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Due Bills": {
      "main": [
        [
          {
            "node": "Bill Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
