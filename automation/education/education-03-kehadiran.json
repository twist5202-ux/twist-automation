{
  "name": "EDUCATION 03 — Laporan Kehadiran Weekly (Orang Tua)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Every Friday 17:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Absensi",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Attendance",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst per = {};\nfor (const r of rows) {\n  const k = r.nama_siswa;\n  if (!per[k]) per[k] = { name: k, hadir: 0, total: 0, WhatsApp: r.WhatsApp };\n  per[k].total++;\n  if ((r.status || '').toLowerCase() === 'hadir') per[k].hadir++;\n}\nreturn Object.values(per).map(p => {\n  const pct = p.total > 0 ? Math.round(p.hadir / p.total * 100) : 0;\n  return { json: { ...p, persen: pct } };\n});\n"
      },
      "id": "n3",
      "name": "Calculate Attendance per Student",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "notes": "Calculate persentase kehadiran every siswa."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{ $json.persen }}",
              "rightValue": "75",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Attendance < 75%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "ATTENDANCE REPORT 📋\\n====================\\nStudent : {{$json.name}}\\nPresent : {{$json.hadir}} out of {{$json.total}} sessions\\nPercent : {{$json.persen}}%\\n\\nAttendance is below 75%. Please pay attention — attendance affects how well the material is understood. If there is an issue, feel free to contact us."
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Alert Parent (Many Absences)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "REKAP KEHADIRAN MINGGUAN\\n========================\\nTotal siswa dilaporkan: {{$('Calculate Attendance per Student').all().length}}\\nYang need perhatian (< 75%) already notified orang tuanya."
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Summarize for Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        420
      ]
    }
  ],
  "connections": {
    "Every Friday 17:00": {
      "main": [
        [
          {
            "node": "Read Attendance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Attendance": {
      "main": [
        [
          {
            "node": "Calculate Attendance per Student",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Attendance per Student": {
      "main": [
        [
          {
            "node": "Attendance < 75%?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attendance < 75%?": {
      "main": [
        [
          {
            "node": "Alert Parent (Many Absences)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Parent (Many Absences)": {
      "main": [
        [
          {
            "node": "Summarize for Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}