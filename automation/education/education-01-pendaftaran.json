{
  "name": "EDUCATION 01 — Registration Siswa New (Auto Confirm)",
  "nodes": [
    {
      "parameters": {
        "path": "edu-list",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Registration Form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "edu-list"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  name: b.name || 'Prospective siswa',\n  orang_tua: b.orang_tua || b.parent || '-',\n  WhatsApp: String(b.WhatsApp || b.phone || '').replace(/[^0-9]/g, ''),\n  program: b.program || 'Reguler',\n  jenjang: b.jenjang || 'SD',\n  asal_sekolah: b.asal_sekolah || '-',\n  time: new Date().toLocaleString('en-US')\n}}];\n"
      },
      "id": "n2",
      "name": "Normalize Registrant",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Samakan format form registration."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Pendaftar",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n3",
      "name": "Log Registrant",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "Thank you for registering {{$json.name}} 🙏\\n\\nWe have received the registration:\\nProgram : {{$json.program}}\\nLevel   : {{$json.jenjang}}\\nWaktu   : {{$json.time}}\\n\\nOur team will contact you within 1x24 hours to schedule the entrance test and interview. If you have any questions, just reply to this chat."
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Confirm to Parent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "NEW REGISTRATION\\n================\\nNama    : {{$('Normalize Registrant').first().json.name}}\\nProgram : {{$('Normalize Registrant').first().json.program}}\\nJenjang : {{$('Normalize Registrant').first().json.jenjang}}\\nWA      : {{$('Normalize Registrant').first().json.WhatsApp}}\\n\\nContact within 1x24 hours."
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Notify Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        300
      ]
    }
  ],
  "connections": {
    "Registration Form": {
      "main": [
        [
          {
            "node": "Normalize Registrant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Registrant": {
      "main": [
        [
          {
            "node": "Log Registrant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Registrant": {
      "main": [
        [
          {
            "node": "Confirm to Parent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm to Parent": {
      "main": [
        [
          {
            "node": "Notify Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}