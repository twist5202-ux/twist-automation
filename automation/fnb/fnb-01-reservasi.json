{
  "name": "FNB 01 — Reservation Meja (Auto Confirm + Reminder)",
  "nodes": [
    {
      "parameters": {
        "path": "fnb-reservation",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Reservation Form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "fnb-reservation"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  name: b.name || 'Customer',\n  WhatsApp: String(b.WhatsApp || b.phone || '').replace(/[^0-9]/g, ''),\n  amount: Number(b.jumlah_orang || b.pax || 2),\n  date: b.date || '-',\n  hour: b.hour || '-',\n  note: b.note || '-',\n  waktu_daftar: new Date().toLocaleString('id-ID')\n}}];\n"
      },
      "id": "n2",
      "name": "Normalize Reservation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Samakan format form reservation."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Reservasi",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n3",
      "name": "Log Reservation",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "RESERVATION RECEIVED ✅\\n====================\\nNama    : {{$json.name}}\\nGuests  : {{$json.amount}} people\\nDate    : {{$json.date}}\\nTime    : {{$json.hour}}\\nNotes   : {{$json.note}}\\n\\nWe look forward to your visit. If anything changes, just reply to this chat."
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Confirm Reservation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "NEW RESERVATION\\n=============\\nNama    : {{$('Normalize Reservation').first().json.name}}\\nJumlah  : {{$('Normalize Reservation').first().json.amount}} orang\\nTanggal: {{$('Normalize Reservation').first().json.date}}\\nJam     : {{$('Normalize Reservation').first().json.hour}}\\nCatatan : {{$('Normalize Reservation').first().json.note}}\\n\\nPrepare a table."
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Notify Restaurant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "n6",
      "name": "Reminder D-1 at 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        500
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Reservasi",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n7",
      "name": "Read Tomorrow's Reservations",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        420,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);\nreturn rows.filter(r => String(r.date || '').slice(0, 10) === tomorrow)\n  .map(r => ({ json: r }));\n"
      },
      "id": "n8",
      "name": "Filter Tomorrow's Reservations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        500
      ],
      "notes": "Fetch reservation that tanggalnya tomorrow."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "RESERVATION REMINDER — TOMORROW ⏰\\n==========================\\nNama    : {{$json.name}}\\nGuests  : {{$json.amount}} people\\nTime    : {{$json.hour}}\\n\\nWe will see you tomorrow. If your plans change, please let us know."
            }
          ]
        },
        "options": {}
      },
      "id": "n9",
      "name": "Reminder to Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        500
      ]
    }
  ],
