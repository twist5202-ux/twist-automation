        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  order_id: b.order_id || 'ORD-' + Date.now(),\n  customer: b.name || 'Customer',\n  WhatsApp: String(b.WhatsApp || b.phone || '').replace(/[^0-9]/g, ''),\n  items: b.items || '-',\n  total: Number(b.total || 0),\n  address: b.address || '-',\n  status: 'received',\n  time: new Date().toLocaleString('en-US')\n}}];\n"
      },
      "id": "n2",
