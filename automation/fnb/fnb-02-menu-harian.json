{
  "name": "FNB 02 — Menu Harian Broadcast (Customer Setia)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 9 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Every Morning 09:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Menu",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Today's Menu",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst day = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][new Date().getDay()];\n\nlet out = 'TODAY\\u2019S MENU 🍽️\\n================\\n\\n';\nfor (const r of rows) {\n  out += '• ' + r.menu_name + ' — Rp ' + Number(r.price).toLocaleString('en-US') + '\\n';\n}\nout += '\\nWant to order? Just reply to this chat. Free delivery for orders over Rp 100,000.';\nreturn [{ json: { broadcast: out } }];\n"
      },
      "id": "n3",
      "name": "Build Menu Broadcast",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "notes": "Susun list menu from Sheets."
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Pelanggan",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n4",
      "name": "Read Customer List",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nreturn rows.filter(r => r.WhatsApp && (r.active || '').toLowerCase() !== 'not')\n  .map(r => ({ json: { target: String(r.WhatsApp).replace(/[^0-9]/g, '') } }));\n"
      },
      "id": "n5",
      "name": "Prepare Broadcast Target",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        500
      ],
      "notes": "Fetch number customer active."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "={{ $('Build Menu Broadcast').first().json.broadcast }}"
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Send Daily Menu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        500
      ]
    }
  ],
  "connections": {
    "Every Morning 09:30": {
      "main": [
        [
          {
            "node": "Read Today's Menu",
            "type": "main",
            "index": 0
          },
          {
            "node": "Read Customer List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Today's Menu": {
      "main": [
        [
          {
            "node": "Build Menu Broadcast",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Menu Broadcast": {
      "main": [
        [
          {
            "node": "Prepare Broadcast Target",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Customer List": {
      "main": [
        [
          {
            "node": "Prepare Broadcast Target",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Broadcast Target": {
      "main": [
        [
          {
            "node": "Send Daily Menu",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}