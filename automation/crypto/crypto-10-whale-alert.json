{
  "name": "CRYPTO 10 — Whale Alert (Transfer Besar di BSC)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.bscscan.com/api?module=account&action=txlist&address=REPLACE_WALLET_ADDRESS&sort=desc&apikey=REPLACE_BSCSCAN_API_KEY",
        "options": {}
      },
      "id": "n2",
      "name": "Fetch Latest Transactions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst d = $input.first().json;\nconst txs = d.result || [];\nconst large = txs.filter(t => {\n  const value = Number(t.value) / 1e18;   // BNB\n  return value >= 10;                      // >= 10 BNB\n});\nreturn large.map(t => ({\n  json: {\n    hash: t.hash,\n    from: t.from,\n    to: t.to,\n    value: (Number(t.value) / 1e18).toFixed(4),\n    time: new Date(t.timeStamp * 1000).toLocaleString('en-US')\n  }\n}));\n"
      },
      "id": "n3",
      "name": "Filter Large Transfers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "🐋 WHALE ALERT\\n\\nNilai  : {{$json.value}} BNB\\nDari   : {{$json.from}}\\nKe     : {{$json.ke}}\\nWaktu  : {{$json.time}}\\nTx     : bscscan.com/tx/{{$json.hash}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Alert Whale",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Check Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Latest Transactions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Latest Transactions": {
      "main": [
        [
          {
            "node": "Filter Large Transfers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Large Transfers": {
      "main": [
        [
          {
            "node": "Alert Whale",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}