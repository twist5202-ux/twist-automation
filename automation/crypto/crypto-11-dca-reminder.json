{
  "name": "CRYPTO 11 — DCA Reminder (Reminder Buy Berkala)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Every Monday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true",
        "options": {}
      },
      "id": "n2",
      "name": "Check Current Price",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst d = $input.first().json;\nconst btc = d.bitcoin;\nconst change = btc.usd_24h_change.toFixed(2);\nconst direction = btc.usd_24h_change >= 0 ? '📈' : '📉';\n\nlet out = 'DCA REMINDER — MONDAY\\n===================\\n\\n';\nout += 'BTC now     : $' + btc.usd.toLocaleString('en-US') + '\\n';\nout += '24h change  : ' + direction + ' ' + change + '%\\n\\n';\nout += 'Time for your weekly DCA!\\n';\nout += 'Planned amount: $REPLACE_DCA_AMOUNT\\n\\n';\nif (btc.usd_24h_change < -5) {\n  out += '💡 Price down ' + Math.abs(change) + '% — a good chance to buy.';\n} else if (btc.usd_24h_change > 5) {\n  out += '⚠️ Price up ' + change + '% — consider reducing the size.';\n} else {\n  out += '👌 Price relatively stable — stick to the plan.';\n}\nreturn [{ json: { message: out } }];\n"
      },
      "id": "n3",
      "name": "Build DCA Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.message}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Send Reminder DCA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Every Monday 09:00": {
      "main": [
        [
          {
            "node": "Check Current Price",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Current Price": {
      "main": [
        [
          {
            "node": "Build DCA Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build DCA Message": {
      "main": [
        [
          {
            "node": "Send Reminder DCA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}