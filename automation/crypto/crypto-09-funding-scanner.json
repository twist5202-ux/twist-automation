{
  "name": "CRYPTO 09 — Funding Rate Scanner (Cari Peluang Arbitrage)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */4 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every 4 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://fapi.binance.com/fapi/v1/premiumIndex?symbol=BTCUSDT",
        "options": {}
      },
      "id": "n2",
      "name": "Fetch Funding Rate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst d = $input.first().json;\nconst rate = parseFloat(d.lastFundingRate) * 100;  // percent\nconst annual = rate * 3 * 365;                       // 3x per day\nconst direction = rate > 0 ? 'Longs pay Shorts' : 'Shorts pay Longs';\n\nlet out = 'FUNDING RATE BTC\\n================\\n';\nout += 'Current rate : ' + rate.toFixed(4) + '%\\n';\nout += 'Direction    : ' + direction + '\\n';\nout += 'Annualized   : ' + annual.toFixed(2) + '%\\n\\n';\n\nif (Math.abs(annual) > 20) {\n  out += '🔥 BIG OPPORTUNITY — annualized above 20%';\n} else if (Math.abs(annual) > 10) {\n  out += '👀 Decent — keep watching';\n} else {\n  out += '😴 Normal — no special opportunity';\n}\nreturn [{ json: { report: out, annual } }];\n"
      },
      "id": "n3",
      "name": "Analyze Funding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{Math.abs($json.annual)}}",
              "rightValue": "10",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Annualized > 10%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.report}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Alert Funding Opportunity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Check Every 4 Hours": {
      "main": [
        [
          {
            "node": "Fetch Funding Rate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Funding Rate": {
      "main": [
        [
          {
            "node": "Analyze Funding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Funding": {
      "main": [
        [
          {
            "node": "Annualized > 10%?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Annualized > 10%?": {
      "main": [
        [
          {
            "node": "Alert Funding Opportunity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}