{
  "name": "CRYPTO 07 — Staking Reward Tracker (Harian)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Day at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.coingecko.com/api/v3/simple/price?ids=REPLACE_TOKEN_ID&vs_currencies=usd&include_24hr_change=true",
        "options": {}
      },
      "id": "n2",
      "name": "Fetch Token Price",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Data",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n3",
      "name": "Read Staking Positions",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst posisi = $('Read Staking Positions').all().map(r => r.json);\nconst price = $input.first().json;\n\nlet out = 'STAKING REPORT\\n================\\n';\nlet totalUsd = 0;\nfor (const p of posisi) {\n  const h = price[p.token_id]?.usd || 0;\n  const value = p.amount * h;\n  totalUsd += value;\n  const rewardHarian = value * (p.apr / 100) / 365;\n  out += '\\n' + p.token.toUpperCase() + '\\n';\n  out += '  Amount   : ' + p.amount + '\\n';\n  out += '  APR      : ' + p.apr + '%\\n';\n  out += '  Value    : $' + value.toFixed(2) + '\\n';\n  out += '  Reward/h : $' + rewardHarian.toFixed(4) + '\\n';\n  out += '  Reward/bl: $' + (rewardHarian * 30).toFixed(2) + '\\n';\n}\nout += '\\n================\\nTOTAL: $' + totalUsd.toFixed(2);\nreturn [{ json: { report: out, totalUsd } }];\n"
      },
      "id": "n4",
      "name": "Calculate Reward & Value",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.report}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Send Staking Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Check Every Day at 08:00": {
      "main": [
        [
          {
            "node": "Fetch Token Price",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Token Price": {
      "main": [
        [
          {
            "node": "Read Staking Positions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Staking Positions": {
      "main": [
        [
          {
            "node": "Calculate Reward & Value",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Reward & Value": {
      "main": [
        [
          {
            "node": "Send Staking Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}