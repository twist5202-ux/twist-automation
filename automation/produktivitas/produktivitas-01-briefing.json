{
  "name": "PRODUKTIVITAS 01 — Morning Briefing (Weather + Crypto + Berita)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 6 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Every Morning 06:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast?latitude=REPLACE_LATITUDE&longitude=REPLACE_LONGITUDE&daily=temperature_2m_max,precipitation_probability_max&timezone=Asia/Jakarta&forecast_days=1",
        "options": {}
      },
      "id": "n2",
      "name": "Today's Weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=usd&include_24hr_change=true",
        "options": {}
      },
      "id": "n3",
      "name": "Crypto Price",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst weather = $('Today's Weather').first().json.daily;\nconst crypto = $input.first().json;\n\nlet out = 'MORNAT PAGI ☀️\\n================\\n\\n';\nout += 'CUACA\\n';\nout += '  Maks   : ' + weather.temperature_2m_max[0] + '°C\\n';\nout += '  Rain  : ' + weather.precipitation_probability_max[0] + '%\\n\\n';\nout += 'CRYPTO\\n';\nout += '  BTC : $' + crypto.bitcoin.usd.toLocaleString('id') +\n       ' (' + crypto.bitcoin.usd_24h_change.toFixed(2) + '%)\\n';\nout += '  ETH : $' + crypto.ethereum.usd.toLocaleString('id') +\n       ' (' + crypto.ethereum.usd_24h_change.toFixed(2) + '%)\\n\\n';\nout += 'Semangat work today! 💪';\nreturn [{ json: { message: out } }];\n"
      },
      "id": "n4",
      "name": "Build Briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.message}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Send Briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Every Morning 06:30": {
      "main": [
        [
          {
            "node": "Today's Weather",
            "type": "main",
            "index": 0
          },
          {
            "node": "Crypto Price",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Crypto Price": {
      "main": [
        [
          {
            "node": "Build Briefing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Briefing": {
      "main": [
        [
          {
            "node": "Send Briefing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}