{
  "name": "PRODUKTIVITAS 03 — Water & Break Reminder (Do not Lupa Minum)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9-17/2 * * 1-6"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Every 2 Working Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst message = [\n  '💧 Drink some water! It has been 2 hours.',\n  '🧴 Rest your eyes. Look at something 20 feet away for 20 seconds.',\n  '🚶 Walk a little. Do not sit the whole time.',\n  '💧 Drink water. Your body needs it.',\n  '🧘 Stretch for 1 minute. Your neck and shoulders are tense.',\n  '💧 Water please now. Target 8 glasses a day.',\n];\nconst i = Math.floor(Math.random() * message.length);\nreturn [{ json: { message: message[i] } }];\n"
      },
      "id": "n2",
      "name": "Random Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.message}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n3",
      "name": "Send Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        280,
        300
      ]
    }
  ],
  "connections": {
    "Every 2 Working Hours": {
      "main": [
        [
          {
            "node": "Random Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Random Message": {
      "main": [
        [
          {
            "node": "Send Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}