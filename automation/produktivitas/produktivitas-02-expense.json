{
  "name": "PRODUKTIVITAS 02 — Expense Tracker (Log Pengeluaran from WA)",
  "nodes": [
    {
      "parameters": {
        "path": "log-expense",
        "options": {}
      },
      "id": "n1",
      "name": "Incoming Expense Message",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -200,
        300
      ],
      "webhookId": "log-pengeluaran"
    },
    {
      "parameters": {
        "jsCode": "\nconst msg = $input.first().json.message || '';\n// format: \"buy coffee 25rb\" or \"buy coffee 25000\"\nconst m = msg.match(/(\\d+)\\s*(rb|thousand|k)?/i);\nlet amount = 0;\nif (m) {\n  amount = Number(m[1]);\n  if (m[2]) amount *= 1000;\n}\nconst description = msg.replace(/(\\d+)\\s*(rb|thousand|k)?/i, '').trim() || 'other';\n\nlet category = 'other';\nconst k = description.toLowerCase();\nif (/food|drink|coffee|chicken|rice|snack|warteg/.test(k)) category = 'food';\nelse if (/fuel|grab|gojek|transport|parking|toll/.test(k)) category = 'transport';\nelse if (/credit|token|electricity|internet|wifi/.test(k)) category = 'bills';\nelse if (/clothes|shoes|shopping|shopee|tokped/.test(k)) category = 'shopping';\n\nreturn [{ json: {\n  amount,\n  description,\n  category,\n  time: new Date().toLocaleString('en-US')\n} }];\n"
      },
      "id": "n2",
      "name": "Parse Amount & Category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Expense",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n3",
      "name": "Log to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "✅ Logged\\n\\nKeterangan : {{$json.description}}\\nAmount     : Rp {{$json.amount}}\\nKategori   : {{$json.category}}\\nWaktu      : {{$json.time}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Confirm Logged",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Incoming Expense Message": {
      "main": [
        [
          {
            "node": "Parse Amount & Category",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Amount & Category": {
      "main": [
        [
          {
            "node": "Log to Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Sheets": {
      "main": [
        [
          {
            "node": "Confirm Logged",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}