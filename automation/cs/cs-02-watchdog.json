    {
      "parameters": {
        "jsCode": "\nconst rows = $(\"Read State Tab\").all().map(r => r.json);\nconst now = Date.now();\n\nconst need = rows.filter(r => {\n  if ((r.mode || \"ai\") !== \"human\") return false;\n  if (!r.escalated_at) return false;\n  const esc = new Date(r.escalated_at).getTime();\n  if (isNaN(esc)) return false;\n  const minutes = (now - esc) / 60000;\n\n  const lastReply = r.last_human_reply ? new Date(r.last_human_reply).getTime() : 0;\n  const hasReplied = lhr > esc;\n\n  const rem = r.last_reminder ? new Date(r.last_reminder).getTime() : 0;\n  const recentReminder = (now - rem) / 60000 < 10;\n\n  return !hasReplied && minutes >= 10 && !recentReminder;\n}).map(r => {\n  const esc = new Date(r.escalated_at).getTime();\n  return {\n    json: {\n      phone: String(r.phone || \"\").replace(/[^0-9]/g, \"\"),\n      wait_minutes: Math.round((now - esc) / 60000),\n      note: r.note || \"-\"\n    }\n  };\n});\n\nreturn need;\n"
      },
