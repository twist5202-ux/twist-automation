              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "SESSION AUTO-CLOSED\\n=====================\\nDari        : {{$json.phone}}\\nIdle       : {{$json.idle_minutes}} minutes\\nStatus     : mode switched back to AI\\n\\nThe customer did not reply within REPLACE_AUTO_CLOSE_MINUTES minutes, so the session was closed automatically. If the customer messages again, the AI will reply."
            }
          ]
        },
        "options": {}
      },
      "id": "w7",
      "name": "Notify Admin of Auto-Close",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        220
      ],
      "notes": "Gateway WhatsApp (Fonnte). Ganti URL if pakai Wablas/MPWA."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
