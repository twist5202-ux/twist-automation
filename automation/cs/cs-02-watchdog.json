{
  "name": "CS HYBRID 02 — Watchdog + Auto-Tutup (Customer Diam → Balik ke AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/2 * * * *"
            }
          ]
        }
      },
      "id": "w1",
      "name": "Check Every 2 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "State",
          "mode": "name"
        },
        "options": {}
      },
      "id": "w2",
      "name": "Read State Tab",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -180,
        300
      ],
      "notes": "Read tab 'State'."
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "History",
          "mode": "name"
        },
        "options": {}
      },
      "id": "w3",
      "name": "Read History Tab",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -180,
        460
      ],
      "notes": "Read tab 'History'."
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $(\"Read State Tab\").all().map(r => r.json);\nconst history = $(\"Read History Tab\").all().map(r => r.json);\nconst now = Date.now();\nconst MINUTES = REPLACE_AUTO_CLOSE_MINUTES;   // change the number, default 15\n\n// find the last customer message per number\nconst lastCustomer = {};\nfor (const h of history) {\n  if ((h.from || \"\") !== \"customer\") continue;\n  const p = String(h.phone || \"\").replace(/[^0-9]/g, \"\");\n  const t = new Date(h.time).getTime();\n  if (isNaN(t)) continue;\n  if (!lastCustomer[p] || t > lastCustomer[p]) lastCustomer[p] = t;\n}\n\nconst autoClose = rows.filter(r => {\n  if ((r.mode || \"ai\") !== \"human\") return false;\n  const p = String(r.phone || \"\").replace(/[^0-9]/g, \"\");\n  const last = lastCustomer[p];\n  if (!last) return false;                       // no data -> skip\n  const idle = (now - last) / 60000;\n  return idle >= MINUTES;\n}).map(r => {\n  const p = String(r.phone || \"\").replace(/[^0-9]/g, \"\");\n  const idle = Math.round((now - lastCustomer[p]) / 60000);\n  return { json: { phone: p, idle_minutes: idle, auto_close: true } };\n});\n\nreturn autoClose;\n"
      },
      "id": "w4",
      "name": "Check Auto-Close",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        300
      ],
      "notes": "Human-mode session that customer-the idle >= threshold -> tutup."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.idle_minutes }}",
              "rightValue": "REPLACE_AUTO_CLOSE_MINUTES",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "w5",
      "name": "Anything Need Auto-Close?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        260,
        300
      ]
    },
