    {
      "parameters": {
        "jsCode": "\nconst { sender, text, pushname } = $(\"Normalize Message\").first().json;\nconst state = $(\"Check Conversation Mode\").first().json;\n\nconst history = (st.history || []).map(h =>\n  (h.from === \"customer\" ? \"Customer\" : \"Agent\") + \": \" + h.message\n).join(\"\\n\") || \"(no history yet)\";\n\nconst system =\n  \"You are a virtual support agent for \" + BIZ + \". Reply in casual Indonesian.\\n\" +\n  \"Operating hours: \" + HOUR + \".\\n\" +\n  \"Aturan:\\n\" +\n  \"1. Reply briefly, max 3 sentences, clear, no waffling.\\n\" +\n  \"2. If you don't know the answer, say 'let me check with the team' — DO NOT make things up.\\n\" +\n  \"3. If the customer asks to talk to a human, complains strongly, or asks for a refund,\\n\" +\n  \"   or an issue beyond your ability, write [ESCALATE] on the first line.\\n\" +\n  \"4. Do not promise anything uncertain (delivery, refund, discount).\\n\" +\n  \"5. Greet the customer by name if available.\";\n\nconst userMsg =\n  \"Chat history:\\n\" + riwayat + \"\\n\\n\" +\n  \"Customer name: \" + (pushname || \"not diketahui\") + \"\\n\" +\n  \"Customer message: \" + text + \"\\n\\n\" +\n  \"Reply now.\";\n\nreturn [{\n  json: {\n    model: \"REPLACE_MODEL_AI\",\n    messages: [\n      { role: \"system\", content: systemPrompt },\n      { role: \"user\", content: userMsg }\n    ],\n    temperature: 0.3,\n    max_tokens: 400\n  }\n}];\n"
      },
