      "parameters": {
        "jsCode": "\nconst { sender } = $(\"Normalize Message\").first().json;\nconst rows = $(\"Read State Tab\").all().map(r => r.json);\n\nconst idx = rows.findIndex(r => String(r.phone || \"\").replace(/[^0-9]/g, \"\") === sender);\nconst row = idx >= 0 ? rows[idx] : null;\n\nconst hist = $(\"Read History Tab\").all().map(r => r.json)\n  .filter(h => String(h.phone || \"\").replace(/[^0-9]/g, \"\") === sender)\n  .slice(-6);\n\nreturn [{\n  json: {\n    sender,\n    ada_state: !!row,\n    mode: row ? (row.mode || \"ai\") : \"ai\",\n    assigned_agent: row ? (row.assigned_agent || \"\") : \"\",\n    escalated_at: row ? (row.escalated_at || \"\") : \"\",\n    last_human_reply: row ? (row.last_human_reply || \"\") : \"\",\n    history: hist\n  }\n}];\n"
      },
