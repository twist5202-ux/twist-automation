      "parameters": {
        "jsCode": "\nconst { sender, text } = $(\"Normalize Message\").first().json;\nconst rows = $(\"Read State Tab\").all().map(r => r.json);\n\nlet target = \"\";\nconst m = text.match(/(?:to|ke)\\s*(62\\d{6,})\\s*[:\\-]?\\s*([\\s\\S]*)/i);\nif (m) {\n  target = m[1];\n  text = m[2].trim();\n}\n\nif (!target) {\n  const humanRows = rows.filter(r => (r.mode || \"ai\") === \"human\");\n  if (humanRows.length > 0) {\n    humanRows.sort((a, b) =>\n      new Date(b.escalated_at || 0) - new Date(a.escalated_at || 0));\n    target = String(humanRows[0].phone || \"\").replace(/[^0-9]/g, \"\");\n  }\n}\n\nconst closeSession = /^(tutup|close|done|finished)/i.test(text.trim());\n\nreturn [{\n  json: {\n    admin: sender,\n    target,\n    admin_message: text.trim(),\n    close_session: closeSession,\n    has_target: !!target\n  }\n}];\n"
      },
