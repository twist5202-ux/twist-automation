    {
      "parameters": {
        "jsCode": "\nconst resp = $input.first().json;\nlet reply = resp.choices?.[0]?.message?.content || resp.message?.content || \"\";\n\nconst escalateMarker = /\\[ESCALATE\\]/i.test(reply);\nreply = reply.replace(/\\[ESCALATE\\]/gi, \"\").trim();\n\nconst { text } = $(\"Normalize Message\").first().json;\nconst t = text.toLowerCase();\n\nconst keywords = [\n  \"human\", \"person\", \"real admin\", \"talk to someone\", \"real agent\",\n  \"complain\", \"complaint\", \"angry\", \"upset\", \"not satisfied\", \"disappointed\",\n  \"refund\", \"return\", \"money back\", \"replace item\", \"broken\",\n  \"report\", \"complaint\", \"fraud\", \"scam\",\n  \"manager\", \"supervisor\", \"owner\", \"boss\"\n];\nconst matched_words = kata.filter(k => t.includes(k));\n\nconst uncertain = /(don't know|can't|let me check|no access|outside)/i.test(reply);\n\nconst escalate = escalateMarker || matched_words.length > 0 || uncertain;\n\nlet reason = \"manual\";\nif (escalateMarker) reason = \"AI requested escalation\";\nelse if (matched_words.length > 0) alasan = \"keyword: \" + matched_words.join(\", \");\nelse if (uncertain) reason = \"AI not confident\";\n\nreturn [{\n  json: {\n    reply,\n    escalate,\n    reason,\n    matched_words\n  }\n}];\n"
      },
