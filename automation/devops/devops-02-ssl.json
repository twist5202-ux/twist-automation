{
  "name": "DEVOPS 02 — SSL Certificate Expiry Checker",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Day at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://REPLACE_DOMAIN_LO.com",
        "options": {}
      },
      "id": "n2",
      "name": "Check SSL Certificate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// The n8n HTTP node returns TLS metadata\nconst meta = $input.first().json;\n// Fallback: calculate manually from a fixed date\nconst expiry = new Date('REPLACE_EXPIRY_DATE');   // set the real date here\nconst now = new Date();\nconst daysLeft = Math.ceil((expiry - now) / 86400000);\n\nlet out = 'SSL CERTIFICATE\\n================\\n';\nout += 'Domain  : REPLACE_DOMAIN_LO.com\\n';\nout += 'Expiry  : ' + expiry.toLocaleDateString('id') + '\\n';\nout += 'Sisa    : ' + sisa + ' hari\\n\\n';\nif (daysLeft <= 7) out += '🔴 CRITICAL — renew NOW';\nelse if (sisa <= 14) out += '🟠 Immediately perbarui (kurang from 2 Sunday)';\nelse if (daysLeft <= 30) out += '🟡 Plan the renewal';\nelse out += '🟢 Still safe';\nreturn [{ json: { report: out, days_left: daysLeft } }];\n"
      },
      "id": "n3",
      "name": "Calculate Days Remaining",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{$json.sisa}}",
              "rightValue": "14",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Days Left <= 14?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.report}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Alert SSL Expiring Soon",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Check Every Day at 07:00": {
      "main": [
        [
          {
            "node": "Check SSL Certificate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check SSL Certificate": {
      "main": [
        [
          {
            "node": "Calculate Days Remaining",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Days Remaining": {
      "main": [
        [
          {
            "node": "Days Left <= 14?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Days Left <= 14?": {
      "main": [
        [
          {
            "node": "Alert SSL Expiring Soon",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}