{
  "name": "DEVOPS 03 — GitHub Release Notifier (Rilis New → Notification)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/REPLACE_OWNER/REPLACE_REPO/releases?per_page=3",
        "options": {}
      },
      "id": "n2",
      "name": "Fetch Latest Release",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rel = $input.first().json;\nconst now = Date.now();\nreturn rel.filter(r => {\n  const t = new Date(r.published_at).getTime();\n  return (now - t) / 3600000 <= 6;\n}).map(r => ({\n  json: {\n    name: r.name || r.tag_name,\n    tag: r.tag_name,\n    author: r.author?.login || '?',\n    url: r.html_url,\n    notes: (r.body || '').slice(0, 200)\n  }\n}));\n"
      },
      "id": "n3",
      "name": "Filter Releases in Last 6 Hours",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "🚀 NEW RELEASE\\n\\nRepo   : REPLACE_OWNER/REPLACE_REPO\\nTag    : {{$json.tag}}\\nNama   : {{$json.name}}\\nAuthor : {{$json.author}}\\n\\n{{$json.notes}}\\n\\n{{$json.url}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Notify New Release",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Check Every 6 Hours": {
      "main": [
        [
          {
            "node": "Fetch Latest Release",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Latest Release": {
      "main": [
        [
          {
            "node": "Filter Releases in Last 6 Hours",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Releases in Last 6 Hours": {
      "main": [
        [
          {
            "node": "Notify New Release",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}