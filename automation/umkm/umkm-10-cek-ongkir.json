{
  "name": "UMKM 10 — Check Shipping Otomatis (Customer Chat → Tarif)",
  "nodes": [
    {
      "parameters": {
        "url": "https://api.rajaongkir.com/starter/cost?origin=REPLACE_KOTA_ASAL&destination={{$json.city}}&weight={{$json.weight}}&courier=jne",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "REPLACE_RAJAONGKIR_API_KEY"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Customer Asks About Shipping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst r = $input.first().json.rajaongkir.results[0].costs;\nlet out = 'SHIPPING RATES\\n==============\\n\\n';\nfor (const c of r) {\n  out += c.service + ' — Rp ' + c.cost[0].value.toLocaleString('en-US') + '\\n';\n  out += '  estimated ' + c.cost[0].etd + ' days\\n';\n}\nreturn [{ json: { message: out } }];\n"
      },
      "id": "n2",
      "name": "Format Tarif",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.message}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n3",
      "name": "Send Rates to Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        280,
        300
      ]
    }
  ],
  "connections": {
    "Customer Asks About Shipping": {
      "main": [
        [
          {
            "node": "Format Tarif",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Tarif": {
      "main": [
        [
          {
            "node": "Send Rates to Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}