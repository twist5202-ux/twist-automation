{
  "name": "UMKM 14 — Auto Post Marketplace (Sheets → Format Ad)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check New Products Every Morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Data",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read New Products",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nreturn rows.filter(r => r.posted !== 'yes').map(r => {\n  const ad =\n    '🔥 ' + r.name + ' 🔥\\n\\n' +\n    '💰 Price: Rp ' + Number(r.price).toLocaleString('en-US') + '\\n' +\n    '📦 Stock: ' + r.stock + ' pcs\\n' +\n    '📏 Size: ' + (r.size || 'all sizes') + '\\n\\n' +\n    '✅ Quality guaranteed\\n' +\n    '✅ COD available / shipping\\n' +\n    '✅ Exchange warranty\\n\\n' +\n    '📲 Order: WhatsApp.me/' + r.admin_wa + '\\n' +\n    '📍 ' + (r.city || 'Indonesia') + '\\n\\n' +\n    '#sale #online #cheap #quality';\n  return { json: { ...r, ad } };\n});\n"
      },
      "id": "n3",
      "name": "Build Ad Copy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.ad}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Send Draft to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Data",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n5",
      "name": "Tandai Already Dibuat",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Check New Products Every Morning": {
      "main": [
        [
          {
            "node": "Read New Products",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read New Products": {
      "main": [
        [
          {
            "node": "Build Ad Copy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Ad Copy": {
      "main": [
        [
          {
            "node": "Send Draft to Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Draft to Admin": {
      "main": [
        [
          {
            "node": "Tandai Already Dibuat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}