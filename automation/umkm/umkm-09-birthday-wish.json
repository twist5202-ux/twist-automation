{
  "name": "UMKM 09 - Birthday Wish (Ucapan + Discount Otomatis)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "sched",
      "name": "Check Birthdays Every Morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "options": {}
      },
      "id": "sheets",
      "name": "Fetch Customer Data",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        460,
        320
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "nama",
        "options": {}
      },
      "id": "split",
      "name": "Check Per Customer",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        680,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.tanggal_lahir }}",
              "rightValue": "={{ $now.format('dd-MM') }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if",
      "name": "Birthday Today?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        320
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "pesan",
              "type": "string",
              "value": "=Happy birthday, {{ $json.name }}!\\n\\nAs a gift, here is a discount code:\\nULANGTAHUN10\\n\\nValid for 7 days on all products.\\n\\nSalam,\\n[Name Store]"
            },
            {
              "id": "e2",
              "name": "nomor_wa",
              "type": "string",
              "value": "={{ $json.nomor_wa }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set",
      "name": "Build Birthday Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.nomor_wa }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http",
      "name": "Send via Gateway WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "nama": "={{ $json.name }}",
            "tanggal_kirim": "={{ $now.format('yyyy-MM-dd') }}",
            "pesan": "={{ $json.message }}"
          }
        },
        "options": {}
      },
      "id": "log",
      "name": "Log to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        1560,
        300
      ]
    }
  ],
  "connections": {
    "Check Birthdays Every Morning": {
      "main": [
        [
          {
            "node": "Fetch Customer Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Customer Data": {
      "main": [
        [
          {
            "node": "Check Per Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Per Customer": {
      "main": [
        [
          {
            "node": "Birthday Today?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Birthday Today?": {
      "main": [
        [
          {
            "node": "Build Birthday Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Birthday Message": {
      "main": [
        [
          {
            "node": "Send via Gateway WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send via Gateway WhatsApp": {
      "main": [
        [
          {
            "node": "Log to Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}