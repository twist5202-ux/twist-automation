{
  "name": "UMKM 15 — Recap Tax & Revenue (Monthly)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 1 * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Every Day at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Data",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read All Orders This Month",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst revenue = rows.reduce((s, r) => s + Number(r.total || 0), 0);\nconst finalTax = revenue * 0.005;      // 0.5% final tax for micro businesses\nconst vat = 0;                        // if not yet VAT-registered\nconst month = new Date().toLocaleString('en-US', { month: 'long', year: 'numeric' });\n\nconst report =\n  'MONTHLY RECAP — ' + month + '\\n' +\n  '=========================\\n' +\n  'Total orders  : ' + rows.length + '\\n' +\n  'Revenue       : Rp ' + revenue.toLocaleString('en-US') + '\\n' +\n  'Average      : Rp ' + Math.round(revenue / Math.max(rows.length,1)).toLocaleString('en-US') + '\\n\\n' +\n  'TAX\\n' +\n  'Final Income Tax 0.5%: Rp ' + Math.round(finalTax).toLocaleString('en-US') + '\\n' +\n  'PPN          : Rp ' + vat.toLocaleString('id') + ' (not yet VAT-registered)\\n\\n' +\n  'Keep records for the annual tax return.';\n\nreturn [{ json: { report, revenue, finalTax } }];\n"
      },
      "id": "n3",
      "name": "Calculate Tax & Revenue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.report}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Send Summary to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Data",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n5",
      "name": "Archive Summary",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Every Day at 07:00": {
      "main": [
        [
          {
            "node": "Read All Orders This Month",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read All Orders This Month": {
      "main": [
        [
          {
            "node": "Calculate Tax & Revenue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Tax & Revenue": {
      "main": [
        [
          {
            "node": "Send Summary to Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Summary to Admin": {
      "main": [
        [
          {
            "node": "Archive Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}