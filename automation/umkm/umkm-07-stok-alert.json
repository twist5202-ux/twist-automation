{
  "name": "UMKM 07 - Stock Alert (Inventory Monitor)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "sched",
      "name": "Check Stock Every Morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "options": {}
      },
      "id": "sheets",
      "name": "Fetch Stock Data",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        460,
        320
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "Stok",
        "options": {}
      },
      "id": "split",
      "name": "Check Per Product",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        680,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.stock }}",
              "rightValue": "={{ $json.minimum }}",
              "operator": {
                "type": "number",
                "operation": "smaller"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if",
      "name": "Stock Below Minimum?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        320
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "pesan",
              "type": "string",
              "value": "=LOW STOCK\\n\\nProduct: {{ $json.product }}\\nRemaining: {{ $json.stock }} units\\nMinimum: {{ $json.minimum }} units\\n\\nRestock now before it runs out."
            },
            {
              "id": "a2",
              "name": "chat_id",
              "type": "string",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            }
          ]
        },
        "options": {}
      },
      "id": "set",
      "name": "Prepare Alert Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.nomor_wa }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "tg",
      "name": "Send Alert WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "notes": "Token Fonnte from dashboard fonnte.com -> Device -> Token. Ganti REPLACE_FONNTE_TOKEN.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=Alert sent for: {{ $json.product }}",
        "options": {}
      },
      "id": "resp",
      "name": "Respon",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1560,
        300
      ]
    }
  ],
  "connections": {
    "Check Stock Every Morning": {
      "main": [
        [
          {
            "node": "Fetch Stock Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Stock Data": {
      "main": [
        [
          {
            "node": "Check Per Product",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Per Product": {
      "main": [
        [
          {
            "node": "Stock Below Minimum?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stock Below Minimum?": {
      "main": [
        [
          {
            "node": "Prepare Alert Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Alert Message": {
      "main": [
        [
          {
            "node": "Send Alert WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Alert WhatsApp": {
      "main": [
        [
          {
            "node": "Respon",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}