{
  "name": "UMKM 12 — Follow-Up Payment (Not yet Bayar → Remind)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Morning at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Data",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Unpaid Orders",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nreturn rows.filter(r => r.status === 'menunggu_bayar')\n  .map(r => ({ json: r }));\n"
      },
      "id": "n3",
      "name": "Filter Unpaid",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "Halo {{$json.name}} 👋\\n\\nOrder *{{$json.order_id}}* is still waiting for payment:\\n\\nProduct : {{$json.product}}\\nTotal   : Rp {{$json.total}}\\n\\nPlease complete the payment before the order is cancelled automatically.\\n\\nNeed help? Just reply to this message."
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Remind Payment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Data",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n5",
      "name": "Log Time Follow-Up",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Check Every Morning at 09:00": {
      "main": [
        [
          {
            "node": "Read Unpaid Orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Unpaid Orders": {
      "main": [
        [
          {
            "node": "Filter Unpaid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Unpaid": {
      "main": [
        [
          {
            "node": "Remind Payment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Remind Payment": {
      "main": [
        [
          {
            "node": "Log Time Follow-Up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}