{
  "name": "UMKM 11 — Cart Reminder (Cart Ditinggalkan → Follow Up)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Data",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Abandoned Cart",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst now = Date.now();\nconst abandoned = rows.filter(r => {\n  const t = new Date(r.time).getTime();\n  const hour = (now - t) / 3600000;\n  return hour >= 3 && r.status === 'cart';\n});\nreturn abandoned.map(r => ({ json: r }));\n"
      },
      "id": "n3",
      "name": "Filter > 3 Hours & Unpaid",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{$json.hour}}",
              "rightValue": "3",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Already > 3 Hours?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "Halo {{$json.name}} 👋\\n\\nWe noticed you left a product in your cart:\\n*{{$json.product}}*\\n\\nStill want to continue? Reply to this message and we will help you complete the order.\\n\\nThere is a promotion running today 🎁"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Send Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Data",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n6",
      "name": "Tandai Already Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1000,
        300
      ]
    }
  ],
  "connections": {
    "Check Every Hour": {
      "main": [
        [
          {
            "node": "Read Abandoned Cart",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Abandoned Cart": {
      "main": [
        [
          {
            "node": "Filter > 3 Hours & Unpaid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter > 3 Hours & Unpaid": {
      "main": [
        [
          {
            "node": "Already > 3 Hours?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Already > 3 Hours?": {
      "main": [
        [
          {
            "node": "Send Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Reminder": {
      "main": [
        [
          {
            "node": "Tandai Already Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}