{
  "name": "UMKM 02 — Order Masuk → Notifikasi + Google Sheets",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-new",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Incoming Order (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        320
      ],
      "webhookId": "order-new-umkm"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "o1",
              "name": "tanggal",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "o2",
              "name": "buyer_name",
              "value": "={{ $json.body.name || $json.name || 'Not diisi' }}",
              "type": "string"
            },
            {
              "id": "o3",
              "name": "no_hp",
              "value": "={{ $json.body.hp || $json.hp || 'Not diisi' }}",
              "type": "string"
            },
            {
              "id": "o4",
              "name": "produk",
              "value": "={{ $json.body.product || $json.product || 'Not diisi' }}",
              "type": "string"
            },
            {
              "id": "o5",
              "name": "jumlah",
              "value": "={{ $json.body.amount || $json.amount || 1 }}",
              "type": "number"
            },
            {
              "id": "o6",
              "name": "total_harga",
              "value": "={{ $json.body.total || $json.total || 0 }}",
              "type": "number"
            },
            {
              "id": "o7",
              "name": "alamat",
              "value": "={{ $json.body.address || $json.address || 'Not diisi' }}",
              "type": "string"
            },
            {
              "id": "o8",
              "name": "catatan",
              "value": "={{ $json.body.note || $json.note || '-' }}",
              "type": "string"
            },
            {
              "id": "o9",
              "name": "status",
              "value": "BARU",
              "type": "string"
            },
            {
              "id": "o10",
              "name": "order_id",
              "value": "=ORD-{{ $now.toFormat('yyyyMMdd-HHmmss') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "norm",
      "name": "Normalize Order Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        320
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Orders",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Order ID": "={{ $json.order_id }}",
            "Tanggal": "={{ $json.date }}",
            "Nama": "={{ $json.buyer_name }}",
            "No HP": "={{ $json.no_hp }}",
            "Produk": "={{ $json.product }}",
            "Jumlah": "={{ $json.amount }}",
            "Total": "={{ $json.total_harga }}",
            "Alamat": "={{ $json.address }}",
            "Catatan": "={{ $json.note }}",
            "Status": "={{ $json.status }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "sheets",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        220
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_CREDENTIAL_ID",
          "name": "Google Sheets UMKM"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "=🛒 *NEW ORDERS*\n\nOrder ID: {{ $json.order_id }}\nName: {{ $json.buyer_name }}\nPhone: {{ $json.no_hp }}\nProduct: {{ $json.product }} (x{{ $json.amount }})\nTotal: Rp {{ $json.total_harga }}\nAddress: {{ $json.address }}\nNote: {{ $json.note }}\n\nProcess it right away!"
            }
          ]
        },
        "options": {}
      },
      "id": "notif",
      "name": "WhatsApp Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        320
      ],
      "notes": "Token Fonnte from dashboard fonnte.com -> Device -> Token. Ganti REPLACE_FONNTE_TOKEN.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"order_id\": \"{{ $json.order_id }}\", \"message\": \"Order received. Our team will confirm shortly.\" }",
        "options": {}
      },
      "id": "resp",
      "name": "Confirm to Buyer",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        320
      ]
    },
    {
      "parameters": {
        "content": "## UMKM 02 — Incoming Order → Notification + Sheets\n\n**How to use:**\n1. Create a Google Sheet with a tab named *Orders*\n2. Fill in the headers: Order ID, Tanggal, Nama, No HP, Produk, Jumlah, Total, Alamat, Catatan, Status\n3. Replace `GANTI_SPREADSHEET_ID` with your sheet ID\n4. Activate the workflow → you get a webhook URL\n5. Put that URL in your order form (Google Form, website, WhatsApp)\n\n**Result:**\n- Incoming orders are saved to Sheets\n- You get a WhatsApp notification immediately\n- The buyer gets an automatic confirmation",
        "height": 340,
        "width": 620,
        "color": 4
      },
      "id": "note",
      "name": "Panduan",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        100
      ]
    }
  ],
  "connections": {
    "Incoming Order (Webhook)": {
      "main": [
        [
          {
            "node": "Normalize Order Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Order Data": {
      "main": [
        [
          {
            "node": "Save to Google Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "WhatsApp Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp Notification": {
      "main": [
        [
          {
            "node": "Confirm to Buyer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}