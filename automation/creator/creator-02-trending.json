{
  "name": "CREATOR 02 — Trending Topic Harian (Ide Konten)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every Morning at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://trends.google.co.id/trending/rss?geo=ID",
        "options": {}
      },
      "id": "n2",
      "name": "Fetch Google Trends ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst raw = $input.first().json;\n// the n8n HTTP node returns an object; take the XML string if present\nconst xml = typeof raw === 'string' ? raw : JSON.stringify(raw);\nconst titles = [...xml.matchAll(/<title>(.*?)<\\/title>/g)].map(m => m[1]);\n// drop the first 2 (RSS header + channel)\nconst top = titles.slice(2, 12);\nlet out = 'TRENDING TOPIC TODAY\\n=====================\\n';\ntop.forEach((t, i) => { out += (i+1) + '. ' + t.replace(/&amp;/g,'&') + '\\n'; });\nout += '\\n💡 Pick 1 and create content today.';\nreturn [{ json: { report: out } }];\n"
      },
      "id": "n3",
      "name": "Extract 10 Trending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.report}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Send Content Ideas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Check Every Morning at 07:00": {
      "main": [
        [
          {
            "node": "Fetch Google Trends ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Google Trends ID": {
      "main": [
        [
          {
            "node": "Extract 10 Trending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract 10 Trending": {
      "main": [
        [
          {
            "node": "Send Content Ideas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}