{
  "name": "CREATOR 03 — Laporan Engagement Weekly (Multi Platform)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Every Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/channels?part=statistics&id=REPLACE_CHANNEL_ID&key=REPLACE_API_KEY_YOUTUBE",
        "options": {}
      },
      "id": "n2",
      "name": "YouTube Channel Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst d = $input.first().json;\nconst s = d.items?.[0]?.statistics || {};\nconst subs = Number(s.subscriberCount || 0);\nconst views = Number(s.viewCount || 0);\nconst videos = Number(s.videoCount || 0);\nconst avg = videos > 0 ? Math.round(views / videos) : 0;\n\nlet out = 'WEEKLY REPORT\\n============\\n\\n';\nout += 'YOUTUBE\\n';\nout += '  Subscribers : ' + subs.toLocaleString('en-US') + '\\n';\nout += '  Total views : ' + views.toLocaleString('en-US') + '\\n';\nout += '  Videos      : ' + videos + '\\n';\nout += '  Avg views   : ' + avg.toLocaleString('en-US') + '\\n\\n';\nout += 'Target next week: +' + Math.max(100, Math.round(subs * 0.05)) + ' subscribers';\nreturn [{ json: { report: out } }];\n"
      },
      "id": "n3",
      "name": "Build Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "={{$json.report}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Send Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Every Monday 08:00": {
      "main": [
        [
          {
            "node": "YouTube Channel Stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "YouTube Channel Stats": {
      "main": [
        [
          {
            "node": "Build Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Report": {
      "main": [
        [
          {
            "node": "Send Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}