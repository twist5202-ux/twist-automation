{
  "name": "CREATOR 01 — YouTube Comment Monitor (Komentar New → Notification)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Check Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/commentThreads?part=snippet&videoId=REPLACE_VIDEO_ID&maxResults=10&order=time&key=REPLACE_API_KEY_YOUTUBE",
        "options": {}
      },
      "id": "n2",
      "name": "Fetch Latest Comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.first().json.items || [];\nconst new = [];\nfor (const it of items) {\n  const c = it.snippet.topLevelComment.snippet;\n  const ageMinutes = (Date.now() - new Date(c.publishedAt).getTime()) / 60000;\n  if (ageMinutes <= 35) {\n    new.push({\n      json: {\n        author: c.authorDisplayName,\n        text: c.textDisplay.slice(0, 150),\n        like: c.likeCount,\n        video: it.snippet.videoId\n      }\n    });\n  }\n}\nreturn new;\n"
      },
      "id": "n3",
      "name": "Filter New Comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "💬 NEW YOUTUBE COMMENT\\n\\nFrom: {{$json.author}}\\nLikes: {{$json.like}}\\n\\n{{$json.text}}\\n\\nyoutube.com/watch?v={{$json.video}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Notify New Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Check Every 30 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Latest Comments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Latest Comments": {
      "main": [
        [
          {
            "node": "Filter New Comments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter New Comments": {
      "main": [
        [
          {
            "node": "Notify New Comment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}