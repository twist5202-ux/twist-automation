    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst total = rows.length;\nconst sold = rows.filter(r => (r.status || '') === 'sold').length;\nconst views = rows.reduce((s, r) => s + (Number(r.views) || 0), 0);\nconst leads = rows.reduce((s, r) => s + (Number(r.lead) || 0), 0);\nconst conversion = views > 0 ? (leads / views * 100).toFixed(1) : '0';\n\nlet out = 'WEEKLY LISTING PERFORMANCE\\n========================\\n\\n';\nout += 'Total listings : ' + total + '\\n';\nout += 'Sold        : ' + sold + '\\n';\nout += 'Total views   : ' + viewss.toLocaleString('id') + '\\n';\nout += 'Total leads   : ' + leads + '\\n';\nout += 'Conversion  : ' + conversion + '%\\n\\n';\n\n// listing terbaik\nconst sorted = [...rows].sort((a, b) => (Number(b.leads)||0) - (Number(a.leads)||0));\nif (sorted.length > 0) {\n  out += 'MOST LEADS:\\n';\n  out += '  ' + (sorted[0].judul || sorted[0].property || '-') +\n         ' (' + (sorted[0].leads || 0) + ' lead)\\n\\n';\n}\nout += 'Listings without leads need photos/price reviewed.';\nreturn [{ json: { report: out } }];\n"
      },
