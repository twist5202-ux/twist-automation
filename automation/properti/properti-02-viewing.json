{
  "name": "PROPERTI 02 — Jadwal Viewing + Reminder Otomatis",
  "nodes": [
    {
      "parameters": {
        "path": "prop-viewing",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Viewing Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "prop-viewing"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  name: b.name || 'Prospective buyer',\n  WhatsApp: String(b.WhatsApp || b.phone || '').replace(/[^0-9]/g, ''),\n  property: b.property || b.listing || '-',\n  date: b.date || '-',\n  hour: b.hour || '-',\n  agent: b.agent || '-',\n  status: 'scheduled'\n}}];\n"
      },
      "id": "n2",
      "name": "Normalize Schedule",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Samakan format jadwal viewing."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Viewing",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n3",
      "name": "Log Schedule",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "VIEWING SCHEDULE CONFIRMED ✅\\n============================\\nProperty : {{$json.property}}\\nDate     : {{$json.date}}\\nTime    : {{$json.hour}}\\nAgent    : {{$json.agent}}\\n\\nThe agent will contact you before leaving. If anything changes, let us know."
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Confirm Schedule",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "VIEWING TERJADWAL\\n================\\nProperti: {{$('Normalize Schedule').first().json.property}}\\nCalon   : {{$('Normalize Schedule').first().json.name}}\\nTanggal : {{$('Normalize Schedule').first().json.date}}\\nJam     : {{$('Normalize Schedule').first().json.hour}}\\nWA      : {{$('Normalize Schedule').first().json.WhatsApp}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Notify Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 16 * * *"
            }
          ]
        }
      },
      "id": "n6",
      "name": "Reminder D-1 at 16:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        520
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Viewing",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n7",
      "name": "Read Tomorrow's Schedule",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        420,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);\nreturn rows.filter(r => String(r.date || '').slice(0, 10) === tomorrow\n  && (r.status || '') !== 'done').map(r => ({ json: r }));\n"
      },
      "id": "n8",
      "name": "Filter Tomorrow's Viewings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        520
      ],
      "notes": "Fetch viewing that tomorrow."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "VIEWING REMINDER — TOMORROW ⏰\\n========================\\nProperty : {{$json.property}}\\nTime    : {{$json.hour}}\\nAgent    : {{$json.agent}}\\n\\nSee you tomorrow. Please bring your ID card."
            }
          ]
        },
        "options": {}
      },
      "id": "n9",
      "name": "Reminder to Prospective Buyer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        520
      ]
    }
  ],
