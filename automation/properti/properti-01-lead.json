{
  "name": "PROPERTI 01 — Lead Qualify + Follow-Up Otomatis",
  "nodes": [
    {
      "parameters": {
        "path": "prop-lead",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Incoming Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "prop-lead"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  name: b.name || 'Prospective buyer',\n  WhatsApp: String(b.WhatsApp || b.phone || '').replace(/[^0-9]/g, ''),\n  type: b.tipe_properti || 'rumah',\n  budget: b.budget || '-',\n  location: b.location || '-',\n  purpose: b.purpose || 'live',\n  time: new Date().toLocaleString('en-US'),\n  status: 'new'\n}}];\n"
      },
      "id": "n2",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Samakan format lead property."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Lead",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n3",
      "name": "Log Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "Halo {{$json.name}} 👋\\n\\nThank you for contacting us about a {{$json.type}} in {{$json.location}}.\\n\\nSo we can find the best match for you, could you tell us:\\n1. What budget are you planning?\\n2. When would you like to schedule a survey or viewing?\\n\\nWe are happy to help."
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Quick Reply to Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "NEW LEAD 🏠\\n==========\\nNama    : {{$('Normalize Lead').first().json.name}}\\nType    : {{$('Normalize Lead').first().json.type}}\\nLocation: {{$('Normalize Lead').first().json.location}}\\nBudget  : {{$('Normalize Lead').first().json.budget}}\\nPurpose : {{$('Normalize Lead').first().json.purpose}}\\nWA      : {{$('Normalize Lead').first().json.WhatsApp}}\\n\\nFollow up within 1 hour."
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Notify Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "n6",
      "name": "Check Idle Leads Daily at 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        520
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Lead",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n7",
      "name": "Read Active Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        420,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst now = Date.now();\nreturn rows.filter(r => {\n  if (r.status !== 'new') return false;\n  const t = new Date(r.time).getTime();\n  return (now - t) / 86400000 >= 2;\n}).map(r => ({ json: r }));\n"
      },
      "id": "n8",
      "name": "Filter Idle > 2 Days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        520
      ],
      "notes": "Lead that idle lebih from 2 hari."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "Hi {{$json.name}}, still looking for a {{$json.type}} in {{$json.location}}?\\n\\nKami new update several listing that mungkin suitable. Want notified? Reply just ya."
            }
          ]
        },
        "options": {}
      },
      "id": "n9",
      "name": "Follow Up Idle Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        520
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
