{
  "name": "AICONTENT 01 — Description Product Otomatis (Marketplace Ready)",
  "nodes": [
    {
      "parameters": {
        "path": "ai-desc",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Request Description",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "ai-desc"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  name: b.nama_produk || b.name || 'Product',\n  category: b.category || 'general',\n  material: b.material || '-',\n  color: b.color || '-',\n  size: b.size || '-',\n  price: b.price || '-',\n  target: b.target || 'online buyer in Indonesia',\n  tone: b.tone || 'casual, persuasive, not exaggerated'\n}}];\n"
      },
      "id": "n2",
      "name": "Normalize Product",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Samakan input product."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_AI_BASE_URL/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_AI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'REPLACE_MODEL_AI', messages: [{ role: 'system', content: You are an e-commerce copywriter for Indonesia. Write a product description ready to paste into Shopee or Tokopedia. Use casual Indonesian. Structure: (1) one-sentence hook, (2) 3-4 benefit bullets, (3) short spec list, (4) call to action. Max 150 words. Do not invent claims that cannot be proven. }], temperature: 0.7, max_tokens: 500 }) }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "n3",
      "name": "Generate Description",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nconst text = r.choices?.[0]?.message?.content || r.message?.content || '';\nreturn [{ json: { description: text.trim() } }];\n"
      },
      "id": "n4",
      "name": "Fetch Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "notes": "Ekstrak teks from respons AI."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Deskripsi",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n5",
      "name": "Save Description",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "PRODUCT DESCRIPTION READY ✍️\\n======================\\n\\n{{$('Fetch Result').first().json.description}}\\n\\nTersimpan di Sheets."
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Send to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    }
  ],
