{
  "name": "AICONTENT 03 — Copy Ad Multi-Variant (A/B Test Ready)",
  "nodes": [
    {
      "parameters": {
        "path": "ai-ads",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Request Ad Copy",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "ai-ads"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  product: b.product || 'Product',\n  manfaat: b.manfaat || '-',\n  target: b.target || 'UMKM Indonesia',\n  price: b.price || '-',\n  platform: b.platform || 'Meta Ads'\n}}];\n"
      },
      "id": "n2",
      "name": "Normalize Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Samakan brief ad."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_AI_BASE_URL/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_AI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'REPLACE_MODEL_AI', messages: [{ role: 'system', content: You are a direct-response copywriter. Write 3 ad copy variants with different angles: (A) problem-solution, (B) social proof, (C) urgency/offer. Each variant: headline max 8 words, 2-3 sentences of body, a clear CTA. Use Indonesian. Max 80 words per variant. }], temperature: 0.7, max_tokens: 500 }) }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "n3",
      "name": "Generate 3 Variants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nconst text = r.choices?.[0]?.message?.content || r.message?.content || '';\nreturn [{ json: { copy_iklan: text.trim() } }];\n"
      },
      "id": "n4",
      "name": "Fetch 3 Variants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "notes": "Ekstrak variant copy from respons AI."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "CopyIklan",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n5",
      "name": "Save Copy",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "AD COPY — 3 VARIANTS 🎯\\n======================\\n\\n{{$('Fetch 3 Variants').first().json.copy_iklan}}\\n\\nTes ketiganya, that menang naikkan budget."
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Send to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    }
  ],
