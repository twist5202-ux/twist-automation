{
  "name": "AICONTENT 02 — Caption Sosmed Harian (IG/TikTok/FB)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Every Morning 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "IdeKonten",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Read Content Ideas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst unused = rows.filter(r => (r.status || 'new') === 'new');\nif (unused.length === 0) return [{ json: { skip: true } }];\nconst pick = unused[Math.floor(Math.random() * unused.length)];\nreturn [{ json: { skip: false, ...pick } }];\n"
      },
      "id": "n3",
      "name": "Pick Unused Idea",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "notes": "Pilih 1 ide acak that not yet dipakai."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{ $json.skip ? 1 : 0 }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Any Ideas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_AI_BASE_URL/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_AI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'REPLACE_MODEL_AI', messages: [{ role: 'system', content: You are a social media manager. Write an Instagram or TikTok caption in Indonesian. Format: a strong hook on the first line, 2-3 sentences of body, a question that drives engagement, then 5-8 relevant hashtags. Tone: casual, human, not corporate. Max 100 words. }], temperature: 0.7, max_tokens: 500 }) }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "n5",
      "name": "Generate Caption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nconst text = r.choices?.[0]?.message?.content || r.message?.content || '';\nreturn [{ json: { caption: text.trim() } }];\n"
      },
      "id": "n6",
      "name": "Fetch Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "notes": "Ekstrak caption from respons AI."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "REPLACE_FONNTE_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "REPLACE_ADMIN_WHATSAPP_NUMBER"
            },
            {
              "name": "message",
              "value": "CAPTION TODAY 📱\\n==================\\n\\n{{$('Fetch Caption').first().json.caption}}\\n\\nCopy-paste, tempel, posting."
            }
          ]
        },
        "options": {}
      },
      "id": "n7",
      "name": "Send Caption to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
